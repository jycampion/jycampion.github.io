---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PubList from '../components/PubList.astro';
import { copy } from '../i18n/copy';
import { ui, profile, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang].publications;
const t = ui[lang];
const pubs = await getCollection('publications');
const order = ['article', 'review', 'preprint', 'conference', 'thesis'] as const;
const counts = order
  .map((k) => [k, pubs.filter((p) => p.data.type === k).length] as const)
  .filter(([, n]) => n > 0);
---
<Base lang={lang} page="publications" title={copy[lang].meta.publications.title} description={copy[lang].meta.publications.description}>
  <div class="wrap">
    <header class="page-head">
      <h1>{c.heading}</h1>
      <p>
        {c.intro}
        {' '}<a href={profile.links.scholar}>Google Scholar</a>.
      </p>
    </header>

    <div class="filters sans" role="group" aria-label={t.filterLabel} hidden>
      <button type="button" data-filter="all" aria-pressed="true">
        {t.pubTypes.all} <span class="n">{pubs.length}</span>
      </button>
      {counts.map(([k, n]) => (
        <button type="button" data-filter={k} aria-pressed="false">
          {t.pubTypes[k]} <span class="n">{n}</span>
        </button>
      ))}
    </div>
    <p class="visually-hidden" aria-live="polite" id="pub-status"></p>

    <section class="list" aria-label={c.heading}>
      <PubList pubs={pubs} lang={lang} groupByYear headingLevel="h2" />
    </section>
  </div>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('.filters');
  const items = [...document.querySelectorAll<HTMLElement>('.pub')];
  const status = document.getElementById('pub-status');
  if (bar) {
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
    const apply = (f: string) => {
      let seen = new Set<string>();
      let shown = 0;
      for (const li of items) {
        const show = f === 'all' || li.dataset.type === f;
        li.hidden = !show;
        const y = li.querySelector('.pub__year');
        if (y) y.classList.toggle('pub__year--first', show && !seen.has(li.dataset.year!));
        if (show) { seen.add(li.dataset.year!); shown++; }
      }
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
      if (status) status.textContent = `${shown}`;
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.25rem;
  }
  .filters button {
    font: inherit;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--ink-2);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    cursor: pointer;
  }
  .filters button:hover { border-color: var(--ink-2); color: var(--ink); }
  .filters button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .filters .n { opacity: 0.7; font-variant-numeric: tabular-nums; margin-left: 0.15rem; }
  .list { border-top: 1px solid var(--ink-2); padding-top: 1.5rem; }
</style>
